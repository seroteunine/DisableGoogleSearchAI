{
  "manifest_version": 2,
  "name": "Disable Google Search AI",
  "description": "Disables AI results in Google search by appending '-ai' to the search query.",
  "version": "1.0",
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "View logged URLs",
    "default_popup": "popup.html"
  },
  "permissions": [
    "tabs", 
    "webNavigation"
  ]
}